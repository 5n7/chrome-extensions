{
  "name": "chrome-extensions",
  "private": true,
  "workspaces": [
    "extensions/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter './extensions/*' build",
    "dev": "bun scripts/dev.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "readme": "bun scripts/readme.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit && bun run --filter './extensions/*' --filter './packages/*' typecheck",
    "ui": "bun run --cwd packages/ui shadcn",
    "zip": "bun run --filter './extensions/*' zip"
  },
  "devDependencies": {
    "@fontsource/kalam": "^5.3.0",
    "@repo/tsconfig": "workspace:*",
    "@types/bun": "^1.4.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "packageManager": "bun@1.4.2"
}
